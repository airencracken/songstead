SONGSTEAD_ADDR=127.0.0.1:8083
SONGSTEAD_DATA_DIR=/var/lib/songstead
# SONGSTEAD_BASE_URL=https://music.example.org
# SONGSTEAD_WITMOOT_URL=https://board.example.org
# SONGSTEAD_SECURE_COOKIES=true
# SONGSTEAD_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Built-in compressed backups: daily, seven copies, 10 GiB archive cap,
# 5 GiB maximum uncompressed snapshot. Set interval to 0 to disable.
# SONGSTEAD_BACKUP_INTERVAL="24h"
# SONGSTEAD_BACKUP_KEEP="7"
# SONGSTEAD_BACKUP_MAX_BYTES="10737418240"
# SONGSTEAD_BACKUP_COPY_MAX_BYTES="5368709120"
