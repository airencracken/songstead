# SPDX-License-Identifier: AGPL-3.0-or-later
# Update the multi-platform base digest through a reviewed change. A runtime
# security update gets a new application patch release, preserving old tags.
FROM alpine:3.23@sha256:21f3e19bafab57a9ff7aa9dd571dac72f868370472c10f450cc0416cc1aca553
ARG VERSION=development
ARG REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/airencracken/songstead" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.revision="$REVISION"
RUN apk add --no-cache ca-certificates tzdata zstd \
    && addgroup -S -g 10001 songstead \
    && adduser -S -D -H -u 10001 -G songstead -h /data songstead \
    && mkdir /data \
    && chown 10001:10001 /data \
    && chmod 0700 /data
ENV SONGSTEAD_DATA_DIR=/data SONGSTEAD_ADDR=:8080 TMPDIR=/tmp
USER 10001:10001
VOLUME ["/data"]
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD port="${SONGSTEAD_ADDR##*:}"; wget -q -T 4 -O /dev/null "http://127.0.0.1:${port:-8080}/healthz" || exit 1
ENTRYPOINT ["/usr/local/bin/songstead"]
# The context contains only verified native release files, staged by release.py.
COPY --chown=0:0 --chmod=0755 bin/songstead /usr/local/bin/songstead
COPY --chown=0:0 docs/ /usr/share/doc/songstead/
